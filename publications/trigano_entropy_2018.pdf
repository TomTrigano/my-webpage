\caption{Results obtained on simulations. The red curve and area denote the MSE and the associated 90\% confidence interval obtained using the proposed thresholding procedure. The blue area represents the range of possible MSEs obtained by setting $\eta$ manually. The proposed method provides error rates as small as the best manual settings, for all the tested activities.}
\label{fig:results}
\end{figure*}




