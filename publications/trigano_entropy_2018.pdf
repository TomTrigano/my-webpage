\begin{figure*}[!ht]
\centering
\includegraphics[width=0.45\linewidth]{responsa_MSE}
\includegraphics[width=0.45\linewidth]{responsa_CV}
\caption{Comparison between approximated MSE (left) and cross-validation function (right) for $\lambda = 0.1$. Minimizing the cross-validation function yields wrong values of $(r,\eta)$.}
\label{fig:cvversustrueMSE}
\end{figure*}

\begin{algorithm}[ht]
\DontPrintSemicolon
\KwData{Time cluster $C_k$, $M_k = \textrm{Card}\  C_k$, timeblocks $\hat{\boldsymbol{\beta}}_i (r), i\in C_k$.}
\KwResult{$\eta_k$, the threshold used for the cluster of times $C_k$.}
\Begin{
Compute $\boldsymbol\gamma_{i} (r) = \dfrac{\|\hat{\boldsymbol\beta}_{i} (r)\|_1}{\displaystyle\sum_{n\in C_k} \|\hat{\boldsymbol\beta}_{n} (r)  \|_1} , i\in C_k$\;
Initialize $\displaystyle H = - \sum_{i\in C_k}\boldsymbol\gamma_{i} (r) \log_2 \boldsymbol\gamma_{i} (r)$\;
Initialize $\displaystyle \eta_k = \max_{i\in C_k} \|\hat{\boldsymbol\beta}_{i} (r)\|_1 $\;
Compute $\displaystyle i_{max} = \arg\max_{i\in C_k} \|\hat{\boldsymbol\beta}_{i} (r)\|_1$ and $J=\{i_{max}\}$\;
\While{$|H-\log_2 M_k| >0.1$ and $J\neq C_k$}{
Compute $$j = \arg\max_{i\in C_k - J} \|\hat{\boldsymbol\beta}_{i} (r)\|_1$$\;
Update $J = J \cup \{j\}$\;
Update $\hat{\boldsymbol\beta}_{i} (r) = \hat{\boldsymbol\beta}_{j} (r)$ for all $i\in J$\;
Update $\boldsymbol\gamma_{i} (r) = \dfrac{\|\hat{\boldsymbol\beta}_{i} (r)\|_1}{\displaystyle\sum_{n\in C_k} \|\hat{\boldsymbol\beta}_{n} (r)  \|_1} , i\in C_k$\;
Update $\displaystyle H = - \sum_{i\in C_k}\boldsymbol\gamma_{i} (r) \log_2 \boldsymbol\gamma_{i} (r)$\;
Update $\displaystyle \eta_k = \max_{i\in C_k} \|\hat{\boldsymbol\beta}_{i} (r)\|_1 $\;
}
}
\caption{Entropy based threshold selection for the cluster $C_k$}
\label{alg:entropy}
\end{algorithm}

